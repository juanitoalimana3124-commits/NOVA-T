# ============================================================
# BC 64 - Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Servidor
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/bc64
# Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/bc64

# JWT
JWT_SECRET=cambia_esto_por_una_clave_super_secreta_de_64_chars_minimo
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Refresh Token
REFRESH_TOKEN_SECRET=otra_clave_super_secreta_diferente_para_refresh_tokens
REFRESH_TOKEN_EXPIRE=30d

# URL del cliente
CLIENT_URL=http://localhost:5173

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_gmail
EMAIL_FROM=BC 64 <noreply@bc64.com>

# Cloudinary (para imágenes de comprobantes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Admin por defecto (se crea al hacer seed)
ADMIN_EMAIL=admin@bc64.com
ADMIN_PASSWORD=Admin2024BC!Seguro

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
